# Copy to .env (which is git-ignored). Everything works with these defaults (no LLM).
# LLMs are only used to re-word hypotheses / handoff text; their output is citation-checked.

# none | anthropic | openai
LLM_PROVIDER=none
# e.g. claude-haiku-5-5 or gpt-4o-mini
LLM_MODEL=
# never commit a real key
LLM_API_KEY=

# Vector side of hybrid retrieval: lsa (default, no download) | sentence-transformers (optional install)
EMBEDDER=lsa
